APP_PROFILE=mock
ENABLE_RAG=false
ENABLE_FLOCI=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AUDIT_STORE=sqlite
AUDIT_DB_PATH=./data/audit.db

# Optional: override the profile's server-side route (still checked against the provider allowlist).
# Defaults: mock -> mock/mock_fallback, local -> mock/ollama, enterprise -> enterprise/none
# PRIMARY_PROVIDER=mock
# FALLBACK_PROVIDER=mock_fallback   # "none" disables fallback

# Optional: fault simulation (simulate_* request fields). Default on for mock/local; cannot be enabled for enterprise.
# ALLOW_SIMULATION=true
