APP_PROFILE=mock
ENABLE_RAG=false
ENABLE_FLOCI=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AUDIT_STORE=sqlite
AUDIT_DB_PATH=./data/audit.db

# Optional: override the profile's server-side route (still checked against the provider allowlist).
# Defaults: mock -> mock/mock_fallback, local -> mock/ollama, enterprise -> enterprise/none
# PRIMARY_PROVIDER=mock
# FALLBACK_PROVIDER=mock_fallback   # "none" disables fallback

# Budget exhaustion (402 / 429 insufficient_quota) falls back only when an alternative budget is approved.
# FALLBACK_ON_QUOTA_EXHAUSTED=false

# External OpenAI-compatible API (local profile). Keys come from your secret store; never commit them.
# OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=

# Remote self-hosted model: private/tunnel address only, token required, https unless tunnel confirmed.
# OLLAMA_API_KEY=
# OLLAMA_CA_BUNDLE=
# OLLAMA_ALLOW_PLAINTEXT_TUNNEL=false

# Optional: fault simulation (simulate_* request fields). Default on for mock/local; cannot be enabled for enterprise.
# ALLOW_SIMULATION=true
